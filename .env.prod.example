"""Environment variables template - production.

This is a template for production environment configuration.
All values MUST be filled with strong, unique values before deployment.
DO NOT use default or weak passwords in production.
"""

# PostgreSQL Configuration - MUST use strong password
POSTGRES_USER=produser
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_DB=agentmanager_prod
POSTGRES_HOST=postgres.internal
POSTGRES_PORT=5432

# Redis Configuration - MUST use strong password
REDIS_URL=redis://:CHANGE_ME_TO_STRONG_PASSWORD@redis.internal:6379/0
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

# Qdrant Vector Database - MUST use strong API key
QDRANT_API_KEY=CHANGE_ME_TO_STRONG_API_KEY_MIN_32_CHARS
QDRANT_HOST=qdrant.internal
QDRANT_PORT=6333

# MinIO Object Storage - MUST use strong credentials
MINIO_ACCESS_KEY=CHANGE_ME_TO_STRONG_ACCESS_KEY_MIN_20_CHARS
MINIO_SECRET_KEY=CHANGE_ME_TO_STRONG_SECRET_KEY_MIN_32_CHARS
MINIO_ENDPOINT=minio.internal:9000
MINIO_BUCKET=agentmanager-prod

# Application Secrets - MUST use strong secret key
SECRET_KEY=CHANGE_ME_TO_STRONG_SECRET_KEY_MIN_64_CHARS

# Logging
LOG_LEVEL=WARNING
DEBUG=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
ALLOWED_HOSTS=api.example.com
CORS_ORIGINS=https://example.com

# Monitoring
PROMETHEUS_ENABLED=True
METRICS_PORT=9090
