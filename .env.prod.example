# Environment variables template for production.
#
# Every value here must be replaced with strong, unique production values
# before deployment. Do not ship this file with placeholder credentials.

# PostgreSQL Configuration - use a strong production password
DATABASE_URL=postgresql://REPLACE_WITH_PRODUCTION_POSTGRES_USER:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@REPLACE_WITH_PRODUCTION_POSTGRES_HOST:5432/REPLACE_WITH_PRODUCTION_POSTGRES_DB
POSTGRES_USER=REPLACE_WITH_PRODUCTION_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=REPLACE_WITH_PRODUCTION_POSTGRES_DB
POSTGRES_HOST=REPLACE_WITH_PRODUCTION_POSTGRES_HOST
POSTGRES_PORT=5432

# Redis Configuration - use a strong production password
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@REPLACE_WITH_PRODUCTION_REDIS_HOST:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Qdrant Vector Database - use a strong production API key
QDRANT_API_KEY=REPLACE_WITH_STRONG_QDRANT_API_KEY
QDRANT_HOST=REPLACE_WITH_PRODUCTION_QDRANT_HOST
QDRANT_PORT=6333

# MinIO Object Storage - use strong production credentials
OBJECT_STORE_ENDPOINT=REPLACE_WITH_PRODUCTION_MINIO_ENDPOINT
OBJECT_STORE_BUCKET=REPLACE_WITH_PRODUCTION_OBJECT_STORE_BUCKET
OBJECT_STORE_ACCESS_KEY=REPLACE_WITH_STRONG_OBJECT_STORE_ACCESS_KEY
OBJECT_STORE_SECRET_KEY=REPLACE_WITH_STRONG_OBJECT_STORE_SECRET_KEY
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET_KEY
MINIO_ENDPOINT=REPLACE_WITH_PRODUCTION_MINIO_ENDPOINT
MINIO_BUCKET=REPLACE_WITH_PRODUCTION_MINIO_BUCKET

# Vector Backend
VECTOR_BACKEND=qdrant
QDRANT_URL=https://REPLACE_WITH_PRODUCTION_QDRANT_HOST

# Application Secrets - use a strong production secret key
SECRET_KEY=REPLACE_WITH_STRONG_APPLICATION_SECRET_KEY

# Logging and Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_CORRELATION_HEADER=X-Request-ID
WORKFLOW_CORRELATION_METADATA_KEY=correlation_id
AUDIT_LOGGER_NAME=agentManager.audit
OTEL_TRACING_ENABLED=False
OTEL_SERVICE_NAME=agentManager
OTEL_EXPORTER_OTLP_ENDPOINT=
DEBUG=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
ALLOWED_HOSTS=REPLACE_WITH_PRODUCTION_ALLOWED_HOSTS
CORS_ORIGINS=REPLACE_WITH_PRODUCTION_CORS_ORIGINS

# Monitoring
PROMETHEUS_ENABLED=True
METRICS_PORT=9090
