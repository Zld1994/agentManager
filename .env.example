# Environment variables template for local development only.
#
# Copy this file to .env for local work and fill in the values for your
# environment. Do not use any local defaults or this template as production
# secrets.

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=
REDIS_PASSWORD=

# Qdrant Vector Database
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinIO Object Storage
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=agentmanager

# Application Secrets
SECRET_KEY=
DEBUG=False

# Logging
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
