# Environment variables template for local development only.
#
# Copy this file to .env for local work and fill in the values for your
# environment. Do not use any local defaults or this template as production
# secrets.

# PostgreSQL Configuration
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=
REDIS_PASSWORD=

# Qdrant Vector Database
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinIO Object Storage
OBJECT_STORE_ENDPOINT=localhost:9000
OBJECT_STORE_BUCKET=agentmanager
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=agentmanager

# Vector Backend
VECTOR_BACKEND=sqlite
QDRANT_URL=http://localhost:6333

# Application Secrets
SECRET_KEY=
DEBUG=False

# Logging
LOG_LEVEL=INFO

# OpenTelemetry tracing
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Audit
AUDIT_SINK=log
AUDIT_REDACT_FIELDS=api_key,password,token

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
